# Copy to .env. Never commit .env.
APP_ORIGIN=http://localhost:3000
BIND_ADDRESS=127.0.0.1
PORT=3000
# Anyone can sign up and create a workspace for their company. Set to false to allow only the
# first account and teammates invited by a workspace owner.
ALLOW_REGISTRATION=true
# Free videos for each new workspace (accounts created before workspaces existed are unlimited).
TRIAL_VIDEO_LIMIT=3
# One key powers the AI director, narration and music (https://openrouter.ai/keys).
# Turn OFF OpenRouter's "Sensitive Info" guardrail for this key: it breaks long agent runs.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Sonnet 5.5 is fast and inexpensive; anthropic/claude-opus-5.5 is the premium option.
AGENT_MODEL=anthropic/claude-sonnet-5.5
# Production only (compose.prod.yaml): video jobs run on on-demand RunPod pods.
# RUNPOD_API_KEY=
