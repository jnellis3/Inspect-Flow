# Copy to .env. Never commit .env or runtime data.
APP_ORIGIN=http://localhost:3000
BIND_ADDRESS=127.0.0.1
PORT=3000
# Blank is allowed for saving and reviewing work without AI.
# Prefer compose.secrets.yaml for a key mounted from ./secrets/openai_api_key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Default: only the first account can register. Enable deliberately for more users.
ALLOW_REGISTRATION=false
